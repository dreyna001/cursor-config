{
  "name": "analyst-portal-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "generate:api": "openapi-zod-client openapi/portal.openapi.json -o src/api/generated/portalSchemas.ts --export-schemas --template openapi/schemas-only.hbs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "install:e2e-browsers": "playwright install chromium",
    "check:stack": "python3 ../../../scripts/check_frontend_stack.py --installed",
    "check:components": "python3 ../../../scripts/check_suite_components.py",
    "test:components": "playwright test --config playwright.components.config.ts",
    "test:foundation": "playwright test --config playwright.foundation.config.ts",
    "check:foundation": "python3 ../../../scripts/check_suite_foundation.py",
    "check:performance": "python3 ../../../scripts/check_suite_performance.py"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@zodios/core": "10.9.6",
    "jsdom": "30.1.3",
    "openapi-zod-client": "1.18.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "follow-redirects": "^1.16.1"
  },
  "engines": {
    "node": "^24.22.1",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1"
}
